{
  "name": "nooq",
  "private": true,
  "workspaces": {
    "packages": ["packages/*"],
    "catalog": {
      "storybook": "10.6.5",
      "@storybook/html-vite": "10.6.5"
    }
  },
  "scripts": {
    "test": "bun test",
    "test:stories": "bun run --cwd packages/design test:stories",
    "lab": "bun run --cwd packages/editor lab",
    "plugin-agent": "bun packages/plugin-agent/src/cli.ts",
    "storybook": "bun run --cwd packages/design storybook",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@nooq/plugin-agent": "workspace:*",
    "bun-types": "^1.4.4",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@lezer/highlight": "^1.2.5",
    "katex": "^0.19.1",
    "pele": "^1.13.0"
  }
}
